# ── Required ────────────────────────────────────────────────────────────────
# OpenAI-compatible chat + embed API (e.g. dmxapi proxy)
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://www.dmxapi.cn/v1

# Admin panel in Streamlit UI (export chat logs). Leave empty to disable admin login.
OER_RAG_ADMIN_KEY=change-me-admin-password

# ── Chat ────────────────────────────────────────────────────────────────────
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SEC=120
OER_RAG_DEFAULT_CHAT_MODEL=gpt-5-mini
OER_RAG_TOP_K=8

# ── Embedding backend ───────────────────────────────────────────────────────
# cloud = BGE-M3 via API (recommended for Linux server, no GPU setup)
# local = subprocess to D:\bge-m3-local embed worker (Windows + CUDA only)
EMBED_BACKEND=cloud
OER_RAG_CLOUD_EMBED_MODEL=bge-m3
OER_RAG_EMBED_BATCH=16
OER_RAG_EMBED_API_PARALLEL=25
OER_RAG_INDEX_FILE_PARALLEL=25
OER_RAG_EMBED_API_TIMEOUT_SEC=90
OER_RAG_EMBED_API_MAX_RETRIES=3
OER_RAG_EMBED_API_RETRY_BACKOFF_SEC=2
OER_RAG_EMBED_BATCH_TIMEOUT_SEC=120
OER_RAG_INDEX_FILE_TIMEOUT_SEC=480

# ── Local embed (Windows dev only; ignore on cloud server) ──────────────────
LOCAL_EMBED_DIR=D:\bge-m3-local
LOCAL_EMBED_PYTHON=D:\bge-m3-local\pyenv\Scripts\python.exe
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_EMBED_DEVICE=cuda

# ── Data paths (override for Docker / custom server layout) ───────────────
# Default without override: ../md (parent of oer_rag) and ./chroma_db
# OER_RAG_MD_DIR=/data/md
# OER_RAG_CHROMA_DIR=/data/chroma_db

# ── Chunking / index ──────────────────────────────────────────────────────
OER_RAG_EMBED_MAX_CHARS_INDEX=0
OER_RAG_EMBED_MAX_CHARS_QUERY=512
OER_RAG_CHUNK_MIN_TOKENS=300
OER_RAG_CHUNK_TARGET_TOKENS=750
OER_RAG_CHUNK_MAX_TOKENS=1024
OER_RAG_CHUNK_OVERLAP_TOKENS=100
OER_RAG_INDEX_VERSION=v2.2
